{
  "manifest_version": 3,
  "name": "Link Navigator",
  "version": "1.0.0",
  "description": "Navigate links using numbers and keyboard shortcuts.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Link Navigator"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/content.css"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}